@model TourWebApp.Data.Models.Tour

@{
    Layout = "_LayoutAdmin";
    var loaiTours = ViewBag.LoaiTours as List<TourWebApp.Data.Models.LoaiTour> ?? new List<TourWebApp.Data.Models.LoaiTour>();
}

<link rel="stylesheet" href="~/css/upload-tour.css" />

<div class="container-fluid">
    <h4 class="mb-3 fw-bold">✏️ Sửa thông tin tour</h4>

    <form asp-action="SuaTour" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="IdTour" />
        <input type="hidden" asp-for="TrangThai" />

        <div class="card shadow-sm p-4">
            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Mã tour</label>
                    <input asp-for="MaTour" class="form-control bg-light" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tên tour</label>
                    <input asp-for="TenTour" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Loại tour</label>
                    <select asp-for="IdLoaiTour" class="form-select">
                        <option value="">-- Chọn loại tour --</option>
                        @foreach (var item in loaiTours)
                        {
                            <option value="@item.IdLoaiTour" selected="@(item.IdLoaiTour == Model.IdLoaiTour)">
                                @item.TenLoai
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Địa điểm</label>
                    <input asp-for="DiaDiem" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Thời gian</label>
                    <input asp-for="ThoiGian" class="form-control" placeholder="VD: 3N2Đ" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Phương tiện</label>
                    <select asp-for="PhuongTien" class="form-select" required>
                        <option value="">-- Chọn phương tiện --</option>
                        <option value="Xe du lịch">🚌 Xe du lịch</option>
                        <option value="Máy bay">✈️ Máy bay</option>
                        <option value="Tàu hỏa">🚆 Tàu hỏa</option>
                        <option value="Ca nô">🚤 Ca nô</option>
                        <option value="Xe máy">🏍 Xe máy</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá gốc</label>
                    <input asp-for="GiaGoc" class="form-control price-input" id="giaGoc" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">% Giảm</label>
                    <input asp-for="PhanTramGiam" class="form-control" id="phanTramGiam" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá khuyến mãi</label>
                    <input asp-for="GiaKhuyenMai" class="form-control price-input" id="giaKhuyenMai" readonly />
                </div>

                <div class="col-12">
                    <label class="form-label">Mô tả</label>
                    <textarea asp-for="MoTa" rows="4" class="form-control"></textarea>
                </div>

                <div class="col-12 mt-4">
                    <h5 class="fw-bold text-primary mb-2">💲 Giá chi tiết theo đối tượng</h5>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Giá người lớn</label>
                            <input type="number" name="GiaNguoiLon" class="form-control" value="@ViewBag.GiaNguoiLon" min="0" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Giá trẻ em</label>
                            <input type="number" name="GiaTreEm" class="form-control" value="@ViewBag.GiaTreEm" min="0" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Giá em bé</label>
                            <input type="number" name="GiaEmBe" class="form-control" value="@ViewBag.GiaEmBe" min="0" required />
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-3">
                    <label class="form-label fw-semibold">Hình ảnh tour</label>

                    <div id="drop-zone" class="drop-zone mb-3">
                        <p class="text-muted mb-0">📷 Kéo thả hoặc click để chọn nhiều ảnh</p>
                        <input type="file" name="HinhAnhFiles" id="fileInput" multiple accept="image/*" hidden />
                    </div>

                    <h6 class="fw-bold mb-2">Ảnh hiện tại</h6>
                    <p class="text-muted small text-end mb-2">Bấm X để xóa ảnh khi lưu</p>
                    <div class="preview-grid">
                        @foreach (var h in Model.HinhTours)
                        {
                            var imagePath = TourImagePathHelper.NormalizeTourImagePath(h.UrlHinh);
                            var isThumbnail = TourImagePathHelper.NormalizeTourImagePath(Model.HinhAnh) == imagePath;
                            <div class="preview-item">
                                <button type="button"
                                        class="remove-current-image"
                                        title="Xóa ảnh"
                                        aria-label="Xóa ảnh">
                                    &times;
                                </button>
                                <input type="checkbox"
                                       name="XoaHinhIds"
                                       value="@h.IdHinh"
                                       class="delete-image-checkbox"
                                       hidden />
                                <div class="preview-image">
                                    <img src="@TourImagePathHelper.ToTourImageSrc(h.UrlHinh)" alt="Ảnh tour" />
                                </div>

                                <label class="thumbnail-radio">
                                    <input type="radio"
                                        name="Thumbnail"
                                        value="@imagePath"
                                        @(isThumbnail ? "checked" : "") />
                                    Ảnh đại diện
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4 text-end">
                <a asp-action="QuanLyTour" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary px-4">💾 Lưu tour</button>
            </div>
        </div>
    </form>
</div>

<script src="~/js/upload-anh-tour.js"></script>
<script src="~/js/tinh-gia-tour.js"></script>
<script>
    document.querySelectorAll(".remove-current-image").forEach(button => {
        button.addEventListener("click", () => {
            const item = button.closest(".preview-item");
            const checkbox = item.querySelector(".delete-image-checkbox");
            const radio = item.querySelector("input[type='radio']");

            checkbox.checked = !checkbox.checked;
            item.classList.toggle("is-marked-delete", checkbox.checked);

            if (checkbox.checked && radio?.checked) {
                radio.checked = false;
            }
        });
    });
</script>
