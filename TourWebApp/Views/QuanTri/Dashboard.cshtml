@using TourWebApp.Data.Models
@{
    Layout = "_LayoutAdmin";

    var period = ViewBag.Period as string ?? "month";
    var topTours = ViewBag.TopTour as IEnumerable<Tour> ?? Enumerable.Empty<Tour>();

    string Active(string value) => period == value ? "active" : "";
}

<link rel="stylesheet" href="~/css/dashboard-admin.css" asp-append-version="true" />

<div class="dash-page">

    <div class="dash-header">
        <div>
            <span class="dash-eyebrow">HappyTrip Analytics</span>
            <h3>Tổng quan hệ thống</h3>
            <p>Theo dõi doanh thu, số lượng khách đặt và tour nổi bật.</p>
        </div>

        <div class="dash-filter">
            <a class="@Active("day")" href="/QuanTri/Dashboard?period=day">Ngày</a>
            <a class="@Active("week")" href="/QuanTri/Dashboard?period=week">Tuần</a>
            <a class="@Active("month")" href="/QuanTri/Dashboard?period=month">Tháng</a>
            <a class="@Active("quarter")" href="/QuanTri/Dashboard?period=quarter">Quý</a>
            <a class="@Active("year")" href="/QuanTri/Dashboard?period=year">Năm</a>
        </div>
    </div>

    <div class="dash-kpi-grid">
        <div class="dash-kpi-card">
            <div>
                <span>Doanh thu</span>
                <h2>@string.Format("{0:N0} đ", ViewBag.TongDoanhThu ?? 0)</h2>
            </div>
            <i class="fa-solid fa-sack-dollar"></i>
        </div>

        <div class="dash-kpi-card">
            <div>
                <span>Đơn đặt tour</span>
                <h2 class="counter" data-count="@ViewBag.TongDon">0</h2>
            </div>
            <i class="fa-solid fa-receipt"></i>
        </div>

        <div class="dash-kpi-card">
            <div>
                <span>Khách đã đặt</span>
                <h2 class="counter" data-count="@ViewBag.TongKhach">0</h2>
            </div>
            <i class="fa-solid fa-user-group"></i>
        </div>

        <div class="dash-kpi-card">
            <div>
                <span>Tour đang bán</span>
                <h2 class="counter" data-count="@ViewBag.TourDangBan">0</h2>
            </div>
            <i class="fa-solid fa-map-location-dot"></i>
        </div>
    </div>

    <div class="dash-chart-grid">
        <div class="dash-panel">
            <div class="panel-head">
                <div>
                    <h5>Doanh thu theo thời gian</h5>
                    <p>Thống kê doanh thu theo bộ lọc đang chọn.</p>
                </div>
            </div>

            <div class="chart-box chart-big">
                <canvas id="chartDoanhThu"></canvas>
            </div>
        </div>

        <div class="dash-panel">
            <div class="panel-head">
                <div>
                    <h5>Khách đặt theo thời gian</h5>
                    <p>Số lượng khách đặt tour theo thời gian.</p>
                </div>
            </div>

            <div class="chart-box">
                <canvas id="chartKhach"></canvas>
            </div>
        </div>
    </div>

    <div class="dash-panel">
        <div class="panel-head">
            <div>
                <h5>Top 3 tour nổi bật</h5>
                <p>Tour có số người đặt cao nhất.</p>
            </div>
        </div>

        <div class="top-tour-list">
          @foreach (var t in topTours)
                {
                    var firstImage = t.HinhTours
                        .Where(h => !string.IsNullOrWhiteSpace(h.UrlHinh))
                        .OrderBy(h => h.ThuTu ?? 999)
                        .FirstOrDefault();

                    var img = "/images/default-tour.jpg";

                    if (firstImage != null)
                    {
                        img = firstImage.UrlHinh.Trim();

                        if (img.StartsWith("~/"))
                        {
                            img = img.Replace("~", "");
                        }
                        else if (!img.StartsWith("/") && !img.StartsWith("http"))
                        {
                            img = "/img/tours/hinhtour/" + img;
                        }
                    }

                    <div class="top-tour-item">

                        <img src="@img"
                            alt=""
                            onerror="this.style.border='3px solid red';" />

                        <div class="tour-info">

                            <strong>@t.TenTour</strong>

                            <span>
                                <i class="fa-solid fa-location-dot"></i>
                                @t.DiaDiem
                            </span>

                            <small>
                                <i class="fa-solid fa-user-group"></i>
                                @t.SoNguoiDaDat người đặt

                                &nbsp;&nbsp;

                                <i class="fa-solid fa-eye"></i>
                                @t.LuotXem lượt xem
                            </small>               
                        </div>
                    </div>
                }
        </div>
    </div>

</div>

<script>
    window.labelDoanhThu = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LabelDoanhThu ?? new List<string>()));
    window.dataDoanhThu = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DataDoanhThu ?? new List<decimal>()));

    window.labelKhach = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LabelKhach ?? new List<string>()));
    window.dataKhach = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DataKhach ?? new List<int>()));
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/dashboard-admin.js" asp-append-version="true"></script>